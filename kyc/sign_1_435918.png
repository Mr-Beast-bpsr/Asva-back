<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#9BE21A"/>
      <stop offset="100%" stop-color="#12C6B3"/>
    </linearGradient>
    <mask id="slash-mask">
      <rect x="0" y="0" width="100" height="100" fill="white"/>
      <!-- Off-center, narrower slash rotated -->
      <rect x="48" y="-20" width="10" height="140" rx="5" fill="black" transform="rotate(25 50 50)"/>
    </mask>
  </defs>
  <circle cx="50" cy="50" r="44" fill="url(#grad)" mask="url(#slash-mask)"/>
</svg>